        <arg name="drone_id" value="29"/>
        <arg name="init_x" value="-32.00"/>
        <arg name="init_y" value="7.00"/>
        <arg name="init_z" value="3.00"/>
        <arg name="target_x" value="27.0"/>
        <arg name="target_y" value="-1.0"/>
        <arg name="target_z" value="1.0"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="swarm_formation_yaml" value="$(arg swarm_formation_yaml)"/>
    </include>
    
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ego_planner)/launch/default_ztr_debug.rviz" required="true" />

  </launch>
